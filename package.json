{
  "name": "medilogng",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "author": "Imradex Global",
  "description": "MediLog NG — EMR for Nigerian hospitals (offline-first web + Android + Electron desktop)",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "test:services": "node scripts/test/pharmacy.service.test.mjs && node scripts/test/requests.test.mjs && node scripts/test/lab.imaging.test.mjs && node scripts/test/lab.lims.test.mjs",
    "test": "node scripts/smoke.mjs && npm run test:services",
    "test:hub": "node scripts/test/hub.smoke.mjs",
    "hub": "node hub/server.js",
    "dev": "vite --port 5174",
    "build": "vite build",
    "preview": "vite preview --port 5174",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "electron:dev": "electron .",
    "electron:test": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:host": "npm run build && electron-builder --win --config electron-builder.host.yml --publish never",
    "publish:desktop": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "electron-updater": "^6.3.0",
    "firebase": "^12.2.1",
    "firebase-admin": "^14.5.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "firebase-tools": "^15.17.0",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=20"
  }
}
