# Public Firebase web config only (never secrets / service accounts here).
# Copy this to .env.local and fill in the VITE_ keys.
# Vite loads .env.local in BOTH `npm run dev` and `npm run build`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=medlogng.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medlogng
VITE_FIREBASE_STORAGE_BUCKET=medlogng.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_USE_EMULATORS=false

# ---- LAN hub (Phase 2) ------------------------------------------------------
# VITE_HUB_URL / VITE_HUB_TOKEN tell the BROWSER where the hospital hub lives.
#   VITE_HUB_URL=http://192.168.1.50:8787   <- the hub PC's LAN IP (blank = hub off)
#   VITE_HUB_TOKEN=<same random value as HUB_TOKEN on the hub PC>
# The hub's OWN settings (HUB_TOKEN, PORT, KEY_FILE) live in a plain `.env`
# file (see hub/README.md) — never prefix those with VITE_, or they would be
# baked into the public browser bundle.
VITE_HUB_URL=
VITE_HUB_TOKEN=
