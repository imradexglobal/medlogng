# Public Firebase web config only (never secrets / service accounts here).
# Copy this to .env.local and fill in the VITE_ keys.
# Vite loads .env.local in BOTH `npm run dev` and `npm run build`.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=medlogng.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=medlogng
VITE_FIREBASE_STORAGE_BUCKET=medlogng.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_USE_EMULATORS=false

# ---- LAN hub (Phase 2/3) ---------------------------------------------------
# The hub no longer uses a shared secret (HUB_TOKEN is obsolete).
# Ward PCs authenticate with the signed-in user's Firebase ID token:
#   Authorization: Bearer <id_token>
# (The hub verifies the token with the Admin SDK and checks the caller's
#  hospital membership in Firestore.)

# Where the hospital hub lives. Defaults to same-origin (the address this
# page was served from). Override with the PC's LAN IP if the app is being
# served from a host on the building LAN.
#   VITE_HUB_URL=http://192.168.1.50:8787   <- leave blank if hub is off
VITE_HUB_URL=

# If the hub listens on a non-default port, set it here:
#   HUB_PORT_DEFAULT=8787  (in electron host config)

# Extra browser origins allowed to call POST /outbox.
# Same-origin (the page's own origin) is always allowed automatically.
# List additional trusted origins below, comma-separated:
#   ALLOWED_ORIGINS=https://medlogng.web.app,https://subdomain.example.com
# Do NOT use '*'; that would bypass the org+capability authorisation.
#   ALLOWED_ORIGINS=

# The firebase project ID (default: medlogng).
#   PROJECT_ID=medlogng

# The port the hub listens on (default: 8787).
#   PORT=8787

# Relay tick interval in milliseconds (default: 15000 = 15s).
#   RELAY_MS=15000