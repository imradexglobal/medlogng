prefix=
exec_prefix=
libdir=${pcfiledir}/../../../libavdevice
includedir=${pcfiledir}/../../..

Name: libavdevice
Description: FFmpeg device handling library
Version: 63.1.102
Requires:  libavfilter >= 12.1.102,  libswscale >= 10.1.102,  libavformat >= 63.1.102,  libavcodec >= 63.1.102,  libswresample >= 7.1.102,  libavutil >= 61.1.102
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -lavdevice -lpsapi -lole32 -lstrmiids -luuid -loleaut32 -lshlwapi -lgdi32 -lm -latomic -lvfw32
Cflags: -I${includedir}
