prefix=
exec_prefix=
libdir=${pcfiledir}/../../../libavfilter
includedir=${pcfiledir}/../../..

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 12.1.102
Requires:  libswscale >= 10.1.102,  libavformat >= 63.1.102,  libavcodec >= 63.1.102,  libswresample >= 7.1.102,  libavutil >= 61.1.102
Conflicts:
Libs: -L${libdir} -Wl,-rpath,${libdir} -lavfilter -lm -latomic
Cflags: -I${includedir}
